{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "amytangerine.com"
        }
      ],
      "destination": "https://www.amytangerine.com/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "photobooth.amytangerine.com"
        }
      ],
      "destination": "https://www.amytangerine.com/photobooth",
      "permanent": true
    }
  ]
}
